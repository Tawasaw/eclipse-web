---
import "../styles/global.css";
import { donationUrl, donationEmbedPath, donationEmbedUrl } from "../data/donation";

const pageTitle = "Eclipse 30618";
const pageDescription =
  "Eclipse 30618 is preparing a new public website for team updates, season information, and community outreach.";

const people: [string, string][] = [
  ["Ali", "Captain"],
  ["Adam", "Vice Captain"],
  ["Zakariya", "Programming / CAD"],
  ["Muhammad", "CAD"],
  ["Nizar", "Programming"],
  ["Hadi", "Programming"],
  ["Yahia", "Programming"],
  ["Rwyd", "Business"],
  ["Adam H", "Member"],
  ["Abdullah", "Member"],
  ["Saayem", "Member"]
];

const roster = people.map(([name, role], i) => ({
  name,
  role,
  num: String(i + 1).padStart(2, "0")
}));

const contacts = [
  { key: "EMAIL", value: "team@eclipse30618.com", href: "mailto:team@eclipse30618.com" },
  { key: "INSTAGRAM", value: "@eclipse30618", href: "https://instagram.com/eclipse.30618" },
  {
    key: "YOUTUBE",
    value: "YouTube Channel",
    href: "https://www.youtube.com/channel/UCyq_GnzewMy3H9HJDqq6XLw"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://eclipse30618.com/" />
    <meta property="og:image" content="https://eclipse30618.com/eclipse-logo.png" />
    <meta name="theme-color" content="#faf9f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#14120f" : "#faf9f4");
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="brand">
          <span class="brand-disc" aria-hidden="true"></span>
          <span class="brand-name">ECLIPSE 30618</span>
          <div class="header-socials" aria-label="Social links">
            <a href="https://www.youtube.com/channel/UCyq_GnzewMy3H9HJDqq6XLw" target="_blank" rel="noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" /></svg></a>
            <a href="https://instagram.com/eclipse.30618" target="_blank" rel="noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="17.5" cy="6.5" r="1.25" fill="currentColor" /></svg></a>
            <a href="mailto:team@eclipse30618.com" aria-label="Email the team"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <a href="https://github.com/Tawasaw" target="_blank" rel="noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.7.4-1.1.7-1.3-2.2-.2-4.5-1.1-4.5-4.8 0-1.1.4-2 1-2.7-.1-.2-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.7 9.7 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.5.1 2.7.6.7 1 1.6 1 2.7 0 3.7-2.3 4.6-4.5 4.8.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.5Z" /></svg></a>
          </div>
        </div>
        <div class="header-actions">
          <nav class="site-nav" aria-label="Primary">
            <a href="#home">HOME</a>
            <a href="#team">TEAM</a>
            <a href="#contact">CONTACT</a>
            <a href={donationUrl}>DONATE</a>
          </nav>
          <button id="theme-toggle" class="btn btn-ghost btn-icon theme-toggle" type="button" aria-label="Toggle dark mode">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          </button>
        </div>
      </header>

      <section id="home" class="hero section-rule" aria-labelledby="site-title">
        <div>
          <div class="eyebrow ecl-rise">FTC TEAM 30618</div>
          <h1 id="site-title" class="ecl-rise">Eclipse <span>30618</span></h1>
          <div class="hero-rule ecl-rule" aria-hidden="true"></div>
          <p class="hero-lede ecl-rise">
            Meet our team, follow our robotics journey, and learn how you can
            support Eclipse 30618.
          </p>
          <div class="hero-status ecl-rise">
            <span class="hero-status-dot" aria-hidden="true"></span>
            <span class="hero-status-text">BUILDING THE FUTURE</span>
          </div>
        </div>
        <div class="eclipse" aria-hidden="true">
          <div class="eclipse-glow"></div>
          <div class="eclipse-disc"></div>
        </div>
      </section>

      <section id="team" class="section-rule" aria-labelledby="team-title">
        <div class="section-head">
          <h2 id="team-title" class="section-title">Team Roster</h2>
          <span class="meta-label">{roster.length} MEMBERS</span>
        </div>
        <ul class="roster">
          {
            roster.map((m) => (
              <li>
                <div class="cell-num">{m.num}</div>
                <div class="cell-name">{m.name}</div>
                <div class="cell-role">{m.role}</div>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="donate" class="donate section-rule" aria-labelledby="donate-title">
        <div class="donate-intro">
          <p class="eyebrow">SUPPORT ECLIPSE 30618</p>
          <h2 id="donate-title" class="section-title">Help us build BioBuzz</h2>
          <p>
            Your support helps our team build, compete, and keep learning through
            robotics. Every contribution makes a difference.
          </p>
          <a class="donate-fallback" href={donationUrl}>Open the full donation page</a>
        </div>
        <div class="donate-form" aria-label="Donation form">
          <div data-zeffy-embed data-form-url={donationEmbedPath}></div>
          <div data-zeffy-embed-fallback style="display: none">
            <div class="donate-iframe-wrap">
              <iframe
                title="Donation form powered by Zeffy"
                data-zeffy-embed-src={donationEmbedUrl}
                allowpaymentrequest
                allowTransparency="true"></iframe>
            </div>
          </div>
          <script
            is:inline
            src="https://www.zeffy.com/embed/v2/zeffy-embed.js"
            onerror="document.querySelectorAll('[data-zeffy-embed-fallback]').forEach(function (el) { el.style.display = 'block'; el.querySelectorAll('iframe[data-zeffy-embed-src]').forEach(function (frame) { frame.src = frame.getAttribute('data-zeffy-embed-src'); }); });"></script>
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="section-title">Contact Us</h2>
        <ul class="contact-list">
          {
            contacts.map((c) => (
              <li>
                <a class="contact-row" href={c.href}>
                  <span class="contact-key">{c.key}</span>
                  <span class="contact-val">{c.value}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <footer class="site-footer">
        <span>ECLIPSE 30618 &mdash; FTC</span>
        <span>TEAM@ECLIPSE30618.COM</span>
      </footer>
    </div>

    <script>
      const themeToggle = document.getElementById("theme-toggle");
      themeToggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        const meta = document.querySelector('meta[name="theme-color"]');
        meta?.setAttribute("content", next === "dark" ? "#14120f" : "#faf9f4");
      });
    </script>
  </body>
</html>
