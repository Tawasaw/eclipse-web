---
import "../styles/global.css";

const pageTitle = "Eclipse 30618 Resources";
const pageDescription = "Resources for Eclipse 30618 team members and mentors.";
const presentationUrl =
  "https://docs.google.com/presentation/d/1jVO_MAPqFnDmqfhWIbnRZ1qha_eCqcn7uS5t3AiBwAY/edit?usp=sharing";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://eclipse30618.com/resources/" />
    <meta property="og:image" content="https://eclipse30618.com/eclipse-logo.png" />
    <meta name="theme-color" content="#faf9f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#14120f" : "#faf9f4");
      })();
    </script>
  </head>
  <body>
    <main class="shell resources-page">
      <section aria-labelledby="resources-title">
        <a class="back-link" href="/">&larr; ECLIPSE 30618</a>
        <h1 id="resources-title" class="section-title">Resources</h1>
        <hr class="hr" />
        <ul class="resource-list">
          <li>
            <a class="resource-row" href={presentationUrl} target="_blank" rel="noopener noreferrer">
              <span class="resource-key">SLIDES</span>
              <span class="resource-val">Team Presentation</span>
            </a>
          </li>
        </ul>
      </section>
    </main>
  </body>
</html>
