---
import "../styles/global.css";
import config from "../data/qualifier-events.json";
import snapshot from "../data/qualifier-assignments.json";
import history from "../data/team-ratings.json";
import rubric from "../data/team-rating-rubric.json";
import QualifierTeam from "../components/QualifierTeam.astro";
import type { TeamRating } from "../data/team-rating";

const teamRatings: Record<string, TeamRating> = history.teams;
const ratingUpdated = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium", timeStyle: "short", timeZone: "America/Los_Angeles"
}).format(new Date(history.updatedAt));

const date = (value: string) => new Intl.DateTimeFormat("en-US", {
  weekday: "short", month: "short", day: "numeric", timeZone: "America/Los_Angeles"
}).format(new Date(`${value}T12:00:00-08:00`));
const updated = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium", timeStyle: "short", timeZone: "America/Los_Angeles"
}).format(new Date(snapshot.updatedAt));
const pending = snapshot.teams.filter(team => !team.events.length && !team.unmappedEvents.length);
const outsideCodes = [...new Set(snapshot.teams.flatMap(team => team.unmappedEvents))].sort((a, b) => a.localeCompare(b, "en", { numeric: true }));
const outsideGroups = outsideCodes.map(code => ({
  id: code,
  name: /^League_/i.test(code) ? `League ${code.replace(/^League_/i, "")}` : code.replace(/_(\d+)$/, " #$1"),
  teams: snapshot.teams.filter(team => team.unmappedEvents.includes(code))
}));
type EventGroup = {
  id: string;
  name: string;
  teams: typeof snapshot.teams;
  date?: string;
  location?: string;
  capacity?: number;
};
const categories: { id: string; name: string; description: string; groups: EventGroup[] }[] = [
  { id: "qualifiers", name: "Dated qualifiers", description: "November–December qualifiers, in date order.",
    groups: config.events.map(event => ({ ...event, teams: snapshot.teams.filter(team => team.events.includes(event.id)) })) },
  { id: "leagues", name: "Leagues", description: "Teams grouped by their published NorCal league code.",
    groups: outsideGroups.filter(group => /^League_/i.test(group.id)) },
  { id: "other-events", name: "Other events", description: "Additional published assignments. Follow a team’s NorCal status link for dates and venues.",
    groups: outsideGroups.filter(group => !/^League_/i.test(group.id)) }
];
---

<!doctype html>
<html lang="en" class="qualifier-document">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Browse BIOBUZZ 2026 NorCal qualifier assignments by event, team name, or team number. Updated nightly from NorCal FTC." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>NorCal Qualifiers · Eclipse 30618</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem("theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      } catch {}
    </script>
  </head>
  <body>
    <div class="shell qualifier-page">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Eclipse 30618 home">
          <span class="brand-disc" aria-hidden="true"></span>
          <span class="brand-name">ECLIPSE 30618</span>
        </a>
        <a href="/">← Team website</a>
      </header>
      <main>
        <section class="qualifier-intro" aria-labelledby="schedule-title">
          <p class="eyebrow">BIOBUZZ / 2026–27 SEASON</p>
          <h1 id="schedule-title">NorCal Qualifiers</h1>
          <p class="qualifier-lede">Find your event. Meet the teams sharing the field.</p>
          <p>Published assignments from <a href={snapshot.source}>NorCal FTC</a>. Refreshes nightly; assignments may change.</p>
          <p class="qualifier-updated">Last successful refresh: <time datetime={snapshot.updatedAt}>{updated} Pacific</time> · {snapshot.teams.length} teams checked</p>
          <p id="stale-note" hidden>The latest refresh is more than two days old. Check NorCal FTC for current assignments.</p>
          <p class="qualifier-rating-intro">The badge beside each name is a <a href="#rating-method">1–10 history rating</a>. Red 10/10 marks a Worlds overall finalist or champion. Open “Rating details” for the result behind a score.</p>
        </section>

        <form class="qualifier-filters" id="qualifier-filters" role="search" hidden>
          <label for="team-filter">Team name or number
            <input id="team-filter" name="team" type="search" placeholder="e.g. Eclipse or 30618" autocomplete="off" />
          </label>
          <label for="event-filter">League or event
            <select id="event-filter" name="event">
              <option value="">All events & teams</option>
              <optgroup label="Browse groups">
                <option value="qualifiers">All dated qualifiers</option>
                <option value="leagues">All leagues</option>
                <option value="other-events">All other events</option>
                <option value="other">All leagues & other events</option>
              </optgroup>
              {categories.filter(category => category.groups.length).map(category =>
                <optgroup label={category.name}>
                  {category.groups.map(group => <option value={group.id}>{group.name}{group.date ? ` · ${date(group.date)}` : ""}</option>)}
                </optgroup>
              )}
              <option value="pending">No published assignment</option>
            </select>
          </label>
          <button class="btn btn-ghost" type="reset">Clear filters</button>
          <button class="btn btn-ghost" id="eclipse-filter" type="button">Find Eclipse</button>
        </form>
        <noscript><p>All published teams are shown below. Enable JavaScript to filter by team and event.</p></noscript>
        <p id="filter-summary" role="status" aria-live="polite"></p>
        <p id="empty-results" hidden>No teams match these filters. Try another team or clear the filters.</p>

        <div id="qualifier-results">
          {categories.filter(category => category.groups.length).map(category =>
            <div class="qualifier-category" data-category={category.id} role="region" aria-labelledby={`category-${category.id}`}>
              <div class="qualifier-category-head">
                <h2 id={`category-${category.id}`}>{category.name}</h2>
                <p>{category.description}</p>
              </div>
              {category.groups.map(group =>
                <section class="qualifier-event" data-event={group.id} data-event-category={category.id} aria-labelledby={`title-${group.id}`}>
                  <div class="qualifier-event-head">
                    <div>
                      {group.date ? <p class="eyebrow"><time datetime={group.date}>{date(group.date)}, 2026</time></p> : <p class="eyebrow">{group.id}</p>}
                      <h3 id={`title-${group.id}`}>{group.name}</h3>
                      {group.location && <p>{group.location}</p>}
                    </div>
                    <p class="qualifier-count"><strong>{group.teams.length}</strong> assigned{group.capacity ? ` / ${group.capacity} capacity` : " teams"}</p>
                  </div>
                  {group.teams.length ? <ul class="qualifier-teams">
                    {group.teams.map(team => <QualifierTeam team={team} rating={teamRatings[String(team.number)]} />)}
                  </ul> : <p class="qualifier-pending">No assignments published for this event yet.</p>}
                </section>
              )}
            </div>
          )}
          <section class="qualifier-event" data-event="pending" aria-labelledby="title-pending">
            <div class="qualifier-event-head"><div><h2 id="title-pending">No published assignment</h2><p>NorCal has not published a qualifier assignment for these teams yet.</p></div><p>{pending.length} teams</p></div>
            <ul class="qualifier-teams">
              {pending.map(team => <QualifierTeam team={team} rating={teamRatings[String(team.number)]} />)}
            </ul>
          </section>
        </div>
        <section id="rating-method" class="qualifier-rating-method" aria-labelledby="rating-method-title">
          <details>
            <summary id="rating-method-title">How the 1–10 history rating works</summary>
            <p>This Eclipse scouting rubric uses a team’s highest recorded milestone in completed official events from {rubric.firstSeason}–{rubric.lastSeason} season starts. It is an achievement summary, not an official FIRST ranking or a prediction of current robot performance.</p>
            <p>Results come from <a href="https://ftcscout.org/api">FTCScout</a>. Last successful history refresh: <time datetime={history.updatedAt}>{ratingUpdated} Pacific</time>. Each team’s details link to the supporting event. Older results may be incomplete; “Unrated” means history is unavailable, while 1/10 means a current-season rookie or no qualification wins in available records.</p>
            <ol class="qualifier-rating-rubric">
              {rubric.levels.map(level => <li><strong>{level.score}/10 · {level.label}</strong><p>{level.description}</p></li>)}
            </ol>
            <p>Practice, scrimmage, off-season, and premier invitational events do not raise the rating. Individual awards do not prove a team reached finals. Worlds division results are distinguished from overall World Championship finals. Scores use the highest milestone, so older achievements remain visible.</p>
          </details>
        </section>
        <p class="qualifier-footnote">Dates, venues, and capacities follow the November–December 2026 NorCal qualifying preference schedule. Counts reflect published assignments, not guaranteed availability. Select a team’s name for its official FIRST page, or NorCal status for its local assignments.</p>
      </main>
      <footer class="site-footer"><span>ECLIPSE 30618 &mdash; FTC</span><a href={snapshot.source}>Source: NorCal FTC ↗</a></footer>
    </div>
    <script>
      const form = document.querySelector<HTMLFormElement>("#qualifier-filters")!;
      const teamInput = document.querySelector<HTMLInputElement>("#team-filter")!;
      const eventInput = document.querySelector<HTMLSelectElement>("#event-filter")!;
      const sections = [...document.querySelectorAll<HTMLElement>("[data-event]")];
      const summary = document.querySelector<HTMLElement>("#filter-summary")!;
      const params = new URLSearchParams(location.search);
      teamInput.value = params.get("team") || "";
      eventInput.value = params.get("event") || "";
      form.hidden = false;

      function filter(updateUrl = true) {
        const query = teamInput.value.trim().toLowerCase();
        const event = eventInput.value;
        const teams = new Set<string>();
        let visibleSections = 0;
        for (const section of sections) {
          let matches = 0;
          const category = section.dataset.eventCategory;
          const eventMatches = !event || section.dataset.event === event || category === event
            || (event === "other" && (category === "leagues" || category === "other-events"));
          for (const row of section.querySelectorAll<HTMLElement>("[data-team]")) {
            row.hidden = !eventMatches || !row.dataset.team!.includes(query);
            if (!row.hidden) { matches++; teams.add(row.dataset.number!); }
          }
          const hasRows = !!section.querySelector("[data-team]");
          section.hidden = !eventMatches || (hasRows ? matches === 0 : !!query);
          if (!section.hidden) visibleSections++;
        }
        for (const category of document.querySelectorAll<HTMLElement>("[data-category]")) {
          category.hidden = ![...category.querySelectorAll<HTMLElement>("[data-event]")].some(section => !section.hidden);
        }
        summary.textContent = `${teams.size} matching team${teams.size === 1 ? "" : "s"} · ${visibleSections} event group${visibleSections === 1 ? "" : "s"}`;
        document.querySelector<HTMLElement>("#empty-results")!.hidden = visibleSections > 0;
        if (updateUrl) {
          const url = new URL(location.href);
          query ? url.searchParams.set("team", teamInput.value.trim()) : url.searchParams.delete("team");
          event ? url.searchParams.set("event", event) : url.searchParams.delete("event");
          history.replaceState(null, "", url);
        }
      }
      form.addEventListener("submit", event => event.preventDefault());
      teamInput.addEventListener("input", () => filter());
      eventInput.addEventListener("change", () => filter());
      form.addEventListener("reset", () => { teamInput.value = ""; eventInput.value = ""; filter(); });
      document.querySelector("#eclipse-filter")!.addEventListener("click", () => {
        teamInput.value = "30618"; eventInput.value = ""; filter();
      });
      const checkedAt = document.querySelector<HTMLTimeElement>(".qualifier-updated time")!.dateTime;
      document.querySelector<HTMLElement>("#stale-note")!.hidden = Date.now() - Date.parse(checkedAt) < 2 * 86400000;
      filter(false);
    </script>
  </body>
</html>
